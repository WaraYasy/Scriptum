# ============================================================================
# CONFIGURACIÓN - Scriptum API
# Copia este archivo como .env y personaliza según tu entorno
# ============================================================================

# Aplicación
APP_NAME=Scriptum API
APP_VERSION=1.0.0
DEBUG=False

# CORS - Orígenes permitidos (formato JSON array)
# Para desarrollo local:
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
# Para producción, añade tu dominio:
# ALLOWED_ORIGINS=["https://tudominio.com","http://localhost:3000"]

# Puerto de la API (usado por Docker)
API_PORT=8000

# Base de datos (descomentar cuando sea necesario)
# DATABASE_URL=sqlite:///./scriptum.db
# DATABASE_URL=postgresql://user:password@localhost/dbname

# ============================================================================
# NOTAS PARA DESPLIEGUE CON DOCKER
# ============================================================================
# 1. DEBUG debe ser False en producción
# 2. Añade el origen de tu cliente a ALLOWED_ORIGINS
# 3. Si usas un dominio, asegúrate de añadirlo a ALLOWED_ORIGINS
