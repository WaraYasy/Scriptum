<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.luna.controller.VentanaController">
<VBox fx:id="root" styleClass="root">
    <!-- MenuBar -->
    <MenuBar styleClass="menu-bar">
        <Menu fx:id="menuArchivo" text="%menu.archivo">
            <Menu fx:id="menuIdioma" text="%menu.idioma">
                <MenuItem fx:id="menuIdiomaEspanol" text="%menu.idioma.espanol" />
                <MenuItem fx:id="menuIdiomaIngles" text="%menu.idioma.ingles" />
            </Menu>
            <MenuItem fx:id="menuThemeToggle" text="%menu.tema.oscuro" />
        </Menu>
        <Menu fx:id="menuAyuda" text="%menu.ayuda">
            <MenuItem fx:id="menuAbout" text="%menu.acerca" />
        </Menu>
        <Menu fx:id="menuClose" styleClass="close-menu" text="%menu.cerrar">
            <MenuItem fx:id="menuExit" text="%menu.salir" />
        </Menu>
      <VBox.margin>
         <Insets />
      </VBox.margin>
    </MenuBar>

    <!-- Contenido principal -->
    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="30" left="30" right="30" top="30" />
        </padding>

        <!-- Sección de Entrada y Salida -->
    <HBox spacing="20">
        <!-- Entrada -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label fx:id="lblSeccionEntrada" styleClass="section-title" text="%seccion.entrada" />
            <HBox alignment="CENTER_LEFT" spacing="10" prefHeight="35">
                <Label fx:id="lblEntradaDescripcion" text="%entrada.descripcion" />
                <Button fx:id="btnSubirArchivo" styleClass="btn-primary" text="%entrada.boton.subir" onAction="#onSubirArchivo" />
            </HBox>
            <TextArea fx:id="txtEntrada" prefHeight="200" promptText="%entrada.placeholder" VBox.vgrow="ALWAYS" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnAccion" styleClass="btn-primary" text="%boton.cifrar" onAction="#onAccionPrincipal" prefWidth="150">
                    <graphic>
                        <FontIcon iconLiteral="fas-lock" iconSize="16" />
                    </graphic>
                </Button>
                <Button fx:id="btnVaciarEntrada" styleClass="btn-secondary" text="%entrada.boton.vaciar" onAction="#onVaciarEntrada">
                    <graphic>
                        <FontIcon iconLiteral="fas-eraser" iconSize="16" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- Salida -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label fx:id="lblSeccionSalida" styleClass="section-title" text="%seccion.salida" />
            <HBox alignment="CENTER_LEFT" spacing="10" prefHeight="35">
                <Label fx:id="lblResultado" text="%salida.resultado.cifrado" />
                <ProgressIndicator fx:id="progressOperacion" prefHeight="25" prefWidth="25" visible="false" />
            </HBox>
            <TextArea fx:id="txtSalida" editable="false" prefHeight="200" promptText="%salida.placeholder" VBox.vgrow="ALWAYS" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnCopiar" styleClass="btn-secondary" text="%salida.boton.copiar" onAction="#onCopiar">
                    <graphic>
                        <FontIcon iconLiteral="fas-copy" iconSize="16" />
                    </graphic>
                </Button>
                <Button fx:id="btnDescargar" styleClass="btn-secondary" text="%salida.boton.descargar" onAction="#onDescargar">
                    <graphic>
                        <FontIcon iconLiteral="fas-download" iconSize="16" />
                    </graphic>
                </Button>
                <Button fx:id="btnVaciarSalida" styleClass="btn-secondary" text="%salida.boton.limpiar" onAction="#onVaciarSalida">
                    <graphic>
                        <FontIcon iconLiteral="fas-trash-alt" iconSize="16" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </HBox>

    <!-- Ajustes de encriptado (Desplegable) -->
    <TitledPane fx:id="titledPaneAjustes" text="%ajustes.titulo" expanded="true" collapsible="true">
        <graphic>
            <FontIcon iconLiteral="fas-cog" iconSize="16" />
        </graphic>
        <VBox spacing="15" style="-fx-padding: 24;">
            <Label fx:id="lblAjustesDescripcion" text="%ajustes.descripcion" />

            <HBox spacing="20">
                <!-- Modo -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblModo" text="%modo.label" />
                    <ComboBox fx:id="comboModo" prefWidth="250" onAction="#onModoChanged" />
                </VBox>

                <!-- Metodo de encriptado -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblMetodo" text="%metodo.label" />
                    <ComboBox fx:id="comboMetodo" prefWidth="250" onAction="#onMetodoChanged" />
                </VBox>
            </HBox>

            <!-- Descripción del metodo -->
            <HBox styleClass="description-panel">
                <Label fx:id="lblDescripcionMetodo" wrapText="true" />
            </HBox>

            <!-- Ajustes avanzados -->
            <Separator />
            <Label fx:id="lblAjustesAvanzados" styleClass="advanced-settings-label" text="%ajustes.avanzados" />

            <!-- Campo de clave (Vigenère) -->
            <VBox fx:id="vboxClaveVigenere" spacing="5" managed="true" visible="true">
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label fx:id="lblClaveVigenere" text="%vigenere.clave.label" />
                </HBox>
                <TextField fx:id="txtClaveVigenere" prefWidth="250" promptText="%vigenere.clave.placeholder" />
                <Label fx:id="lblClaveVigenereDesc" styleClass="field-description" text="%vigenere.clave.descripcion" />
            </VBox>

            <!-- Campos para AES -->
            <VBox fx:id="vboxCamposAes" spacing="15" managed="false" visible="false">
                <!-- Password -->
                <VBox spacing="5">
                    <Label fx:id="lblPasswordAes" text="%aes.password.label" />
                    <TextField fx:id="txtPasswordAes" prefWidth="250" promptText="%aes.password.placeholder" />
                    <Label fx:id="lblPasswordAesDesc" styleClass="field-description" text="%aes.password.descripcion" />
                </VBox>

                <!-- Tipo de AES -->
                <VBox spacing="5">
                    <Label fx:id="lblTipoAes" text="%aes.tipo.label" />
                    <ComboBox fx:id="comboTipoAes" prefWidth="250" />
                    <Label fx:id="lblTipoAesDesc" styleClass="field-description" text="%aes.tipo.descripcion" />
                </VBox>

                <!-- Salt (solo para descifrado) -->
                <VBox fx:id="vboxSaltAes" spacing="5" managed="false" visible="false">
                    <Label fx:id="lblSaltAes" text="%aes.salt.label" />
                    <TextField fx:id="txtSaltAes" prefWidth="250" promptText="%aes.salt.placeholder" />
                    <Label fx:id="lblSaltAesDesc" styleClass="field-description" text="%aes.salt.descripcion" />
                </VBox>
            </VBox>

            <!-- Mensaje de estado -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblMensajeEstado" text="" />
            </HBox>
        </VBox>
    </TitledPane>

        <!-- Estado de conexión con la API -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label fx:id="lblEstadoApiTitulo" text="%api.estado.label" />
            <Label fx:id="lblEstadoApi" text="%api.estado.verificando" />
            <ProgressIndicator fx:id="progressConexion" prefHeight="20" prefWidth="20" visible="false" />
        </HBox>

    </VBox>
</VBox>

    <!-- Icono del tema en la esquina superior derecha -->
    <ImageView fx:id="iconoTema" fitHeight="80" fitWidth="80" preserveRatio="true" pickOnBounds="false" StackPane.alignment="TOP_RIGHT">
        <image>
            <Image url="@../img/Icono-Claro.png" />
        </image>
        <StackPane.margin>
            <Insets top="10" right="10"/>
        </StackPane.margin>
    </ImageView>
</StackPane>
