<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" styleClass="root" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.luna.controller.VentanaController">
    <!-- MenuBar -->
    <MenuBar styleClass="menu-bar">
        <Menu text="%menu.archivo">
            <MenuItem fx:id="menuThemeToggle" text="%menu.tema.oscuro" />
        </Menu>
        <Menu text="%menu.ayuda">
            <MenuItem fx:id="menuAbout" text="%menu.acerca" />
        </Menu>
        <Menu fx:id="menuClose" styleClass="close-menu" text="%menu.cerrar">
            <MenuItem fx:id="menuExit" text="%menu.salir" />
        </Menu>
      <VBox.margin>
         <Insets />
      </VBox.margin>
    </MenuBar>

    <!-- Contenido principal -->
    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="30" left="30" right="30" top="30" />
        </padding>

        <!-- Estado de conexión con la API -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="%api.estado.label" />
            <Label fx:id="lblEstadoApi" text="%api.estado.verificando" />
            <ProgressIndicator fx:id="progressConexion" prefHeight="20" prefWidth="20" visible="false" />
        </HBox>

        <!-- Sección de Entrada y Salida -->
    <HBox spacing="20">
        <!-- Entrada -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="%seccion.entrada" />
            <HBox alignment="CENTER_LEFT" spacing="10" prefHeight="35">
                <Label text="%entrada.descripcion" />
                <Button fx:id="btnSubirArchivo" styleClass="btn-primary" text="%entrada.boton.subir" onAction="#onSubirArchivo" />
            </HBox>
            <TextArea fx:id="txtEntrada" prefHeight="200" promptText="%entrada.placeholder" VBox.vgrow="ALWAYS" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnAccion" styleClass="btn-primary" text="%boton.cifrar" onAction="#onAccionPrincipal" prefWidth="150" />
                <Button fx:id="btnVaciarEntrada" styleClass="btn-secondary" text="%entrada.boton.vaciar" onAction="#onVaciarEntrada" />
            </HBox>
        </VBox>

        <!-- Salida -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="%seccion.salida" />
            <HBox alignment="CENTER_LEFT" spacing="10" prefHeight="35">
                <Label fx:id="lblResultado" text="%salida.resultado.cifrado" />
                <ProgressIndicator fx:id="progressOperacion" prefHeight="25" prefWidth="25" visible="false" />
            </HBox>
            <TextArea fx:id="txtSalida" editable="false" prefHeight="200" promptText="%salida.placeholder" VBox.vgrow="ALWAYS" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnCopiar" styleClass="btn-secondary" text="%salida.boton.copiar" onAction="#onCopiar" />
                <Button fx:id="btnDescargar" styleClass="btn-secondary" text="%salida.boton.descargar" onAction="#onDescargar" />
                <Button fx:id="btnVaciarSalida" styleClass="btn-secondary" text="%salida.boton.limpiar" onAction="#onVaciarSalida" />
            </HBox>
        </VBox>
    </HBox>

    <!-- Ajustes de encriptado (Desplegable) -->
    <TitledPane text="%ajustes.titulo" expanded="true" collapsible="true">
        <VBox spacing="15" style="-fx-padding: 24;">
            <Label text="%ajustes.descripcion" />

            <HBox spacing="20">
                <!-- Modo -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="%modo.label" />
                    <ComboBox fx:id="comboModo" prefWidth="250" promptText="%modo.placeholder" onAction="#onModoChanged" />
                </VBox>

                <!-- Metodo de encriptado -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="%metodo.label" />
                    <ComboBox fx:id="comboMetodo" prefWidth="250" promptText="%metodo.placeholder" onAction="#onMetodoChanged" />
                </VBox>
            </HBox>

            <!-- Descripción del metodo -->
            <HBox styleClass="description-panel">
                <Label fx:id="lblDescripcionMetodo" text="%metodo.descripcion.default" wrapText="true" />
            </HBox>

            <!-- Ajustes avanzados -->
            <Separator />
            <Label styleClass="advanced-settings-label" text="%ajustes.avanzados" />

            <!-- Campo de clave (Vigenère) -->
            <VBox fx:id="vboxClaveVigenere" spacing="5" managed="true" visible="true">
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label text="%vigenere.clave.label" />
                </HBox>
                <TextField fx:id="txtClaveVigenere" prefWidth="250" promptText="%vigenere.clave.placeholder" />
                <Label styleClass="field-description" text="%vigenere.clave.descripcion" />
            </VBox>

            <!-- Campos para AES -->
            <VBox fx:id="vboxCamposAes" spacing="15" managed="false" visible="false">
                <!-- Password -->
                <VBox spacing="5">
                    <Label text="%aes.password.label" />
                    <TextField fx:id="txtPasswordAes" prefWidth="250" promptText="%aes.password.placeholder" />
                    <Label styleClass="field-description" text="%aes.password.descripcion" />
                </VBox>

                <!-- Tipo de AES -->
                <VBox spacing="5">
                    <Label text="%aes.tipo.label" />
                    <ComboBox fx:id="comboTipoAes" prefWidth="250" promptText="%aes.tipo.placeholder" />
                    <Label styleClass="field-description" text="%aes.tipo.descripcion" />
                </VBox>

                <!-- Salt (solo para descifrado) -->
                <VBox fx:id="vboxSaltAes" spacing="5" managed="false" visible="false">
                    <Label text="%aes.salt.label" />
                    <TextField fx:id="txtSaltAes" prefWidth="250" promptText="%aes.salt.placeholder" />
                    <Label styleClass="field-description" text="%aes.salt.descripcion" />
                </VBox>
            </VBox>

            <!-- Mensaje de estado -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblMensajeEstado" text="" />
            </HBox>
        </VBox>
    </TitledPane>
    </VBox>
</VBox>
