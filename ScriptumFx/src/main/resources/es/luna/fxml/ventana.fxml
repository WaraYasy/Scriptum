<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" styleClass="root" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.luna.controller.VentanaController">
    <!-- MenuBar -->
    <MenuBar styleClass="menu-bar">
        <Menu text="Archivo">
            <MenuItem fx:id="menuThemeToggle" text="Cambiar a Modo Oscuro" />
        </Menu>
        <Menu text="Ayuda">
            <MenuItem fx:id="menuAbout" text="Acerca de" />
        </Menu>
        <Menu fx:id="menuClose" styleClass="close-menu" text="Cerrar">
            <MenuItem fx:id="menuExit" text="Salir" />
        </Menu>
      <VBox.margin>
         <Insets />
      </VBox.margin>
    </MenuBar>

    <!-- Contenido principal -->
    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="30" left="30" right="30" top="30" />
        </padding>

        <!-- Sección de Entrada y Salida -->
    <HBox spacing="20">
        <!-- Entrada -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Entrada" />
            <HBox alignment="CENTER_LEFT" spacing="10" prefHeight="35">
                <Label text="Introduce el texto que quieras encriptar o" />
                <Button styleClass="btn-primary" text="Sube tu archivo" />
            </HBox>
            <TextArea prefHeight="200" promptText="Enter your secret message..." VBox.vgrow="ALWAYS" />
            <Button styleClass="btn-primary" text="🔄 Vaciar" />
        </VBox>

        <!-- Salida -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Salida" />
            <HBox alignment="CENTER_LEFT" spacing="10" prefHeight="35">
                <Label text="Resultado de la encriptación" />
            </HBox>
            <TextArea editable="false" prefHeight="200" promptText="Your encrypted text will appear here..." VBox.vgrow="ALWAYS" />
            <HBox spacing="10">
                <Button styleClass="btn-secondary" text="📋 Copy" />
                <Button styleClass="btn-secondary" text="⬇ Descargar archivo" />
            </HBox>
        </VBox>
    </HBox>

    <!-- Ajustes de encriptado (Desplegable) -->
    <TitledPane text="⚙ Ajustes de encriptado" expanded="false" collapsible="true">
        <VBox spacing="15" style="-fx-padding: 24;">
            <Label text="Elige el modo de encriptado y el método de encriptación" />

            <HBox spacing="20">
                <!-- Modo -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Modo" />
                    <ComboBox prefWidth="250" promptText="🔒 Encriptado" />
                </VBox>

                <!-- Metodo de encriptado -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Método de encriptado" />
                    <ComboBox prefWidth="250" promptText="Vigenère" />
                </VBox>
            </HBox>

            <!-- Descripción del metodo -->
            <HBox styleClass="description-panel">
                <Label text="Vigenère: Usa una clave repetida para desplazar letras con patrones variables" wrapText="true" />
            </HBox>

            <!-- Ajustes avanzados -->
            <Separator />
            <Label styleClass="advanced-settings-label" text="AJUSTES AVANZADOS" />

            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label text="Clave de encriptado" />
                    <Label styleClass="eye-icon" text="👁" />
                </HBox>
                <TextField prefWidth="150" text="3" />
                <Label styleClass="field-description" text="Descripción de la clave" />
            </VBox>

            <Button styleClass="btn-primary" text="Clave aleatoria" />
        </VBox>
    </TitledPane>
    </VBox>
</VBox>
